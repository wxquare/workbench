digraph G {
graph [rankdir=LR, nodesep=0.52, ranksep=0.85, splines=true, overlap=false, pad=0.2];
node [shape=box, style=rounded, fontname="Helvetica", fontsize=14, width=2.35, height=0.88, margin=0.15];
edge [fontname="Helvetica", fontsize=11, arrowsize=0.85];
w [label="workspaces\nPK workspace_id / team_id"];
th [label="threads\nPK thread_id / active_run_id"];
r [label="runs\nPK run_id / status / epoch"];
j [label="run_jobs\nrun_id / generation / lease"];
ev [label="run_events\nPK run_id + seq"];
cp [label="graph_checkpoints\n快照 + pending writes"];
i [label="interrupts\nrun_id / graph_interrupt_id"];
rr [label="resume_requests\ninterrupt_id / response"];
ti [label="tool_invocations\nlogical_call_id / receipt"];
ed [label="evidence\nsource / quality / artifact_ref"];
a [label="actions / approvals\naction_key / hash / state"];
o [label="outbox\naction_id / delivery state"];
art [label="artifacts\nobject_key / sha256 / status"];
w -> th [label="1 : N"];
th -> r [label="1 : N"];
r -> j [label="1 : N"];
r -> ev [label="1 : N"];
r -> cp [label="1 : N"];
r -> i [label="1 : N"];
i -> rr [label="1 : N history"];
r -> ti [label="1 : N"];
ti -> ed [label="1 : N"];
ed -> art [label="N : 1 optional"];
r -> a [label="1 : N"];
a -> o [label="1 : N"];
}