# Resolved from the official Python OCI index; SQLite source is checksum-verified.
# Build from the workbench project root: docker build -f deploy/Dockerfile.agent .
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS sqlite-build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN curl --fail --location https://www.sqlite.org/2026/sqlite-autoconf-3530100.tar.gz -o sqlite.tar.gz \
    && echo "83e6b2020a034e9a7ad4a72feea59e1ad52f162e09cbd26735a3ffb98359fc4f  sqlite.tar.gz" | sha256sum -c - \
    && tar -xzf sqlite.tar.gz --strip-components=1 \
    && ./configure --prefix=/opt/sqlite --disable-static --disable-readline \
    && make -j2 && make install

FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS web-build
WORKDIR /build
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS wheel-build
WORKDIR /build
RUN pip install --no-cache-dir uv==0.11.8
COPY apps/agent/pyproject.toml apps/agent/uv.lock apps/agent/.python-version ./
COPY apps/agent/src ./src
RUN uv build --wheel --out-dir /wheels

FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c AS runtime
COPY --from=sqlite-build /opt/sqlite/lib/libsqlite3.so* /opt/sqlite/lib/
ENV LD_LIBRARY_PATH=/opt/sqlite/lib \
    WORKBENCH_ASSET_ROOT=/opt/workbench/assets \
    WORKBENCH_FRONTEND_DIST_ROOT=/opt/workbench/web/dist \
    WORKBENCH_PERSISTENT_ROOT=/var/lib/workbench \
    WORKBENCH_DATABASE_URL=sqlite+aiosqlite:////var/lib/workbench/workbench.sqlite3 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/workbench
RUN pip install --no-cache-dir uv==0.11.8
COPY apps/agent/pyproject.toml apps/agent/uv.lock apps/agent/.python-version ./
# Frozen dependencies plus the built distribution; resources stay outside wheel.
RUN uv sync --frozen --no-dev --no-install-project
COPY --from=wheel-build /wheels /wheels
RUN uv pip install --python /opt/workbench/.venv/bin/python --no-deps /wheels/*.whl \
    && rm -rf /wheels \
    && /opt/workbench/.venv/bin/python -c "import sqlite3; assert sqlite3.sqlite_version_info >= (3,51,3), sqlite3.sqlite_version" \
    && useradd --uid 10001 --create-home workbench \
    && mkdir -p /var/lib/workbench /opt/workbench/assets \
    && chown -R workbench:workbench /var/lib/workbench /opt/workbench/assets
COPY config /opt/workbench/assets/config
COPY --from=web-build /build/dist /opt/workbench/web/dist
# Mount a local persistent volume here. Doctor refuses an absent/unmigrated DB.
VOLUME ["/var/lib/workbench"]
USER workbench
ENV PATH="/opt/workbench/.venv/bin:$PATH"
ENTRYPOINT ["workbench"]
CMD ["doctor", "--config", "/opt/workbench/assets/config/local/agent.example.yaml"]
